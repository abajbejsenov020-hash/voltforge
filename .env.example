# Local defaults. Root npm scripts load .env if it exists.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=data/voltforge.sqlite
# Set to the exact public origin when deploying behind an HTTPS proxy.
# APP_ORIGIN=https://your-domain.example
# Account sign-in and hosted garages use a Supabase project.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
