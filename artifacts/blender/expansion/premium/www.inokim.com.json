[{"id": 10373168660796, "title": "KIX", "handle": "kix", "body_html": "<p data-start=\"160\" data-end=\"228\"><strong data-start=\"160\" data-end=\"228\">Inokim Kix \u2013 Where Lightweight Design Meets Everyday Performance</strong></p>\n<p data-start=\"230\" data-end=\"500\">The Inokim Kix is built for riders who want simplicity, efficiency, and reliability \u2014 without compromising on performance. Designed with a lightweight frame and a clean, modern aesthetic, it delivers a smooth and effortless riding experience perfect for daily urban use.</p>\n<p data-start=\"502\" data-end=\"809\">Whether you're commuting to work, running errands, or enjoying a casual ride, the Kix offers the ideal balance between portability and power. Its responsive acceleration and stable handling make navigating city streets easy, while its compact design ensures convenient storage and transport wherever you go.</p>\n<p data-start=\"811\" data-end=\"1049\">Engineered with Inokim\u2019s signature attention to detail, the Kix maintains durability and comfort in a minimal, streamlined form. It\u2019s the perfect entry point into premium electric mobility \u2014 practical, stylish, and built to move with you.</p>\n<p data-start=\"1051\" data-end=\"1070\"><strong data-start=\"1051\" data-end=\"1070\">Key Highlights:</strong></p>\n<ul data-start=\"1071\" data-end=\"1295\">\n<li data-section-id=\"18ka52r\" data-start=\"1071\" data-end=\"1104\">Lightweight and easy to carry</li>\n<li data-section-id=\"8k4gmx\" data-start=\"1105\" data-end=\"1151\">Smooth and stable ride for daily commuting</li>\n<li data-section-id=\"6b166q\" data-start=\"1152\" data-end=\"1204\">Clean, minimal design with premium build quality</li>\n<li data-section-id=\"14fkq3k\" data-start=\"1205\" data-end=\"1253\">Compact and practical for urban environments</li>\n<li data-section-id=\"1bz75d1\" data-start=\"1254\" data-end=\"1295\">Reliable performance you can count on</li>\n</ul>\n<p data-start=\"1297\" data-end=\"1410\" data-is-last-node=\"\" data-is-only-node=\"\">The Inokim Kix is more than just a scooter \u2014 it\u2019s your everyday solution for moving smarter, faster, and lighter.</p>", "published_at": "2026-04-26T03:04:11-04:00", "created_at": "2026-04-26T02:55:59-04:00", "updated_at": "2026-11-17T10:29:21-05:00", "vendor": "INOKIM NYC", "product_type": "scooter", "tags": ["vehicle"], "variants": [{"id": 53012216250684, "title": "Inokim Kix / Black", "option1": "Inokim Kix", "option2": "Black", "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": {"id": 55022846476604, "product_id": 10373168660796, "position": 4, "created_at": "2026-04-26T02:59:40-04:00", "updated_at": "2026-04-26T02:59:42-04:00", "alt": null, "width": 3543, "height": 2319, "src": "https://cdn.shopify.com/s/files/1/0870/8993/8748/files/kixpdpblack.png?v=1777186782", "variant_ids": [53012216250684]}, "available": true, "price": "1100.00", "grams": 0, "compare_at_price": "0.00", "position": 1, "product_id": 10373168660796, "created_at": "2026-04-26T02:55:59-04:00", "updated_at": "2026-11-17T10:29:21-05:00"}, {"id": 53012216283452, "title": "Inokim Kix / White", "option1": "Inokim Kix", "option2": "White", "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": {"id": 55022846116156, "product_id": 10373168660796, "position": 1, "created_at": "2026-04-26T02:58:41-04:00", "updated_at": "2026-04-26T02:58:43-04:00", "alt": null, "width": 3543, "height": 2319, "src": "https://cdn.shopify.com/s/files/1/0870/8993/8748/files/kixpdpwhite.png?v=1777186723", "variant_ids": [53012216283452]}, "available": true, "price": "1100.00", "grams": 0, "compare_at_price": "0.00", "position": 2, "product_id": 10373168660796, "created_at": "2026-04-26T02:55:59-04:00", "updated_at": "2026-11-17T10:29:21-05:00"}, {"id": 53012216316220, "title": "Inokim Kix / Green", "option1": "Inokim Kix", "option2": "Green", "option3": null, "sku": null, "requires_shipping": t