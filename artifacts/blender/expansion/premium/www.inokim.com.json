": "https://cdn.shopify.com/s/files/1/0870/8993/8748/files/kixpdpgreen.png?v=1777186837", "width": 3543, "height": 2319}], "options": [{"name": "model", "position": 1, "values": ["Inokim Kix"]}, {"name": "color", "position": 2, "values": ["Black", "White", "Green"]}]}, {"id": 9954842050876, "title": "Quick 4", "handle": "quick-4", "body_html": "<p><span style=\"font-weight: 400;\">Meet the Quick 4 \u2013 folds in 4 seconds, effortlessly unlocking adventure wherever you choose. With a sleek foot-activated release to fold and unfold within a heartbeat.</span></p>\n<p><span style=\"font-weight: 400;\">Rev up your ride with an upgraded large display, a robust 600W moto. The front and rear drum braking system ensures reliable stopping power, complemented by a water-resistant IPX4 rating. Revel in max comfort with the dual suspension system, all while enjoying the benefits of power and portability.</span></p>\n<p><span style=\"font-weight: 400;\">Boasting an extra-long deck for enhanced riding stability and comfort, adorned with LED lights.</span></p>\n<p><span style=\"font-weight: 400;\">Feel confident and secure knowing this model of Quick is SGS-certified for UL 2272, guaranteeing both an exhilarating ride and secure storage.\u00a0</span></p>\n<p><span style=\"font-weight: 400;\">Crafted by TLV's top tech artists, the Quick 4 is not just a scooter \u2013 it's a stylish statement..</span></p>", "published_at": "2026-04-26T02:55:22-04:00", "created_at": "2025-03-16T16:40:30-04:00", "updated_at": "2026-11-17T10:29:21-05:00", "vendor": "INOKIM NYC", "product_type": "scooter", "tags": [], "variants": [{"id": 51499945820476, "title": "Hero- Top Range 36 Miles / Blue", "option1": "Hero- Top Range 36 Miles", "option2": "Blue", "option3": null, "sku": "", "requires_shipping": true, "taxable": true, "featured_image": {"id": 50857622995260, "product_id": 9954842050876, "position": 1, "created_at": "2025-03-16T16:39:16-04:00", "updated_at": "2025-03-16T16:39:17-04:00", "alt": null